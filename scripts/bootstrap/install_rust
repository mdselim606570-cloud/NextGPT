#!/bin/bash
set -euo pipefail

# Install the Rust toolchain and system dependencies required to build
# the Tauri desktop app (src-tauri). Mirrors the toolchain/targets used
# in .github/workflows/app.yml.

ARCH="$(uname -m)"
OS="$(uname -s)"

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "❌ Required command not found: $1"
    exit 1
  fi
}

case "$OS" in
  Linux)
    need_cmd curl
    # Detect the distro for system package installation.
    if [ -f /etc/os-release ]; then
      # shellcheck disable=SC1091
      . /etc/os-release
      DISTRO="$ID"
    else
      echo "❌ Cannot determine Linux distribution."
      exit 1
    fi

    if ! command -v rustup >/dev/null 2>&1; then
      echo "🦀 Installing rustup..."
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
      # shellcheck disable=SC1091
      . "$HOME/.cargo/env"
    fi

    rustup toolchain install stable --profile minimal
    rustup default stable

    case "$DISTRO" in
      ubuntu|debian)
        echo "📦 Installing Tauri system dependencies (apt)..."
        sudo apt-get update
        sudo apt-get install -y \
          libgtk-3-dev \
          libappindicator3-dev \
          librsvg2-dev \
          patchelf \
          curl \
          build-essential

        # WebKitGTK dev package name varies by distro version.
        if sudo apt-get install -y libwebkit2gtk-4.0-dev 2>/dev/null; then
          :
        elif sudo apt-get install -y libwebkit2gtk-4.1-dev 2>/dev/null; then
          :
        else
          echo "⚠️  Could not install a WebKitGTK dev package; install manually."
        fi
        ;;
      centos|rhel|fedora|amzn)
        echo "📦 Installing Tauri system dependencies (yum/dnf)..."
        if command -v dnf >/dev/null 2>&1; then
          sudo dnf install -y \
            gtk3-devel \
            webkit2gtk4.0-devel \
            libappindicator3-devel \
            librsvg2-devel \
            patchelf \
            curl \
            gcc gcc-c++ make
        else
          sudo yum install -y \
            gtk3-devel \
            webkit2gtk4.0-devel \
            libappindicator3-devel \
            librsvg2-devel \
            patchelf \
            curl \
            gcc gcc-c++ make
        fi
        ;;
      arch)
        echo "📦 Installing Tauri system dependencies (pacman)..."
        sudo pacman -Syu --needed --noconfirm \
          gtk3 \
          webkit2gtk \
          libappindicator3 \
          librsvg \
          patchelf \
          curl \
          base-devel
        ;;
      *)
        echo "⚠️  Unsupported Linux distribution: $DISTRO. Install Tauri deps manually."
        ;;
    esac
    ;;
  Darwin)
    if ! command -v rustup >/dev/null 2>&1; then
      echo "🦀 Installing rustup..."
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
      # shellcheck disable=SC1091
      . "$HOME/.cargo/env"
    fi

    rustup toolchain install stable --profile minimal
    rustup default stable
    ;;
  *)
    echo "❌ Unsupported operating system: $OS"
    exit 1
    ;;
esac

# Add common cross-compilation targets used by the Tauri release matrix.
rustup target add \
  x86_64-unknown-linux-gnu \
  aarch64-apple-darwin \
  x86_64-apple-darwin \
  x86_64-pc-windows-msvc 2>/dev/null || echo "⚠️  Some targets could not be added (expected on non-matching hosts)."

echo "✅ Rust toolchain installed."
rustc --version
cargo --version
