#!/bin/bash
set -euo pipefail

# Bootstrap NextGPT for local development.
# Installs dependencies, configures environment, and prepares git hooks.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "❌ Required command not found: $1"
    exit 1
  fi
}

require_cmd node
require_cmd pnpm

ensure_webkit_4_0_compat() {
  local pc_dir lib_dir include_dir
  pc_dir="$(pkg-config --variable=pcfiledir webkit2gtk-4.1)"
  lib_dir="$(pkg-config --variable=libdir webkit2gtk-4.1)"
  include_dir="$(pkg-config --variable=includedir webkit2gtk-4.1)/webkitgtk-4.1"

  if [ ! -f "$pc_dir/javascriptcoregtk-4.0.pc" ]; then
    sudo tee "$pc_dir/javascriptcoregtk-4.0.pc" >/dev/null <<EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=$lib_dir
includedir=$include_dir

Name: JavaScriptCoreGTK+
Description: JavaScriptCoreGTK+ compatibility shim (4.0 -> 4.1)
Version: 2.52.6
Requires: glib-2.0 gobject-2.0
Libs: -L\${libdir} -ljavascriptcoregtk-4.1
Cflags: -I\${includedir}
EOF
  fi
  if [ ! -f "$pc_dir/webkit2gtk-4.0.pc" ]; then
    sudo tee "$pc_dir/webkit2gtk-4.0.pc" >/dev/null <<EOF
prefix=/usr
exec_prefix=\${prefix}
libdir=$lib_dir
includedir=$include_dir

Name: WebKitGTK
Description: WebKitGTK compatibility shim (4.0 -> 4.1)
URL: https://webkitgtk.org
Version: 2.52.6
Requires: glib-2.0 gtk+-3.0 libsoup-3.0 javascriptcoregtk-4.1
Libs: -L\${libdir} -lwebkit2gtk-4.1
Cflags: -I\${includedir}
EOF
  fi
  sudo ln -sf libjavascriptcoregtk-4.1.so "$lib_dir/libjavascriptcoregtk-4.0.so" 2>/dev/null || true
  sudo ln -sf libjavascriptcoregtk-4.1.so.0 "$lib_dir/libjavascriptcoregtk-4.0.so.0" 2>/dev/null || true
  sudo ln -sf libwebkit2gtk-4.1.so "$lib_dir/libwebkit2gtk-4.0.so" 2>/dev/null || true
  sudo ln -sf libwebkit2gtk-4.1.so.0 "$lib_dir/libwebkit2gtk-4.0.so.0" 2>/dev/null || true
}

ensure_system_deps() {
  case "$(uname -s)" in
    Linux)
      if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
      else
        echo "⚠️  Cannot determine Linux distribution; skipping system package install."
        return
      fi
      case "$ID" in
        ubuntu|debian)
          echo "📦 Installing Tauri system dependencies (apt)..."
          sudo apt-get update
          sudo apt-get install -y \
            libgtk-3-dev \
            libappindicator3-dev \
            librsvg2-dev \
            patchelf \
            curl \
            build-essential
          if sudo apt-get install -y libwebkit2gtk-4.0-dev 2>/dev/null; then
            :
          elif sudo apt-get install -y libwebkit2gtk-4.1-dev 2>/dev/null; then
            ensure_webkit_4_0_compat
          else
            echo "⚠️  Could not install a WebKitGTK dev package; install manually."
          fi
          ;;
        centos|rhel|fedora|amzn)
          echo "📦 Installing Tauri system dependencies (yum/dnf)..."
          PKG_MANAGER="yum"
          if command -v dnf >/dev/null 2>&1; then
            PKG_MANAGER="dnf"
          fi
          BASE_PKGS=(gtk3-devel librsvg2-devel patchelf gcc gcc-c++ make)
          if ! command -v curl >/dev/null 2>&1; then
            BASE_PKGS+=(curl)
          fi
          if sudo $PKG_MANAGER install -y webkit2gtk4.0-devel libappindicator3-devel "${BASE_PKGS[@]}"; then
            :
          elif sudo $PKG_MANAGER install -y webkit2gtk4.1-devel libappindicator-gtk3-devel "${BASE_PKGS[@]}"; then
            ensure_webkit_4_0_compat
          else
            echo "⚠️  Could not install WebKitGTK/appindicator dev packages; install manually."
          fi
          ;;
        arch)
          echo "📦 Installing Tauri system dependencies (pacman)..."
          sudo pacman -Syu --needed --noconfirm \
            gtk3 \
            webkit2gtk \
            libappindicator3 \
            librsvg \
            patchelf \
            curl \
            base-devel
          ;;
        *)
          echo "⚠️  Unsupported Linux distribution: $ID. Install Tauri deps manually."
          ;;
      esac
      ;;
    Darwin)
      if ! xcode-select -p >/dev/null 2>&1; then
        echo "🍎 Installing Xcode command line tools..."
        xcode-select --install
      fi
      ;;
  esac
}

ensure_system_deps

echo "📦 Installing dependencies (pnpm)..."
pnpm install --frozen-lockfile

if [ ! -f .env.local ]; then
  if [ -f .env.template ]; then
    echo "🔧 Creating .env.local from .env.template..."
    cp .env.template .env.local
  else
    echo "⚠️  .env.template not found; skipping .env.local creation"
  fi
else
  echo "✓ .env.local already exists, leaving untouched"
fi

if [ -f package.json ] && pnpm run | grep -qE '^\s*mask\b'; then
  echo "🎭 Building masks..."
  pnpm mask
fi

if [ -d .husky ] || pnpm run | grep -qE '^\s*prepare\b'; then
  echo "🪝 Installing git hooks (husky)..."
  pnpm prepare
fi

echo "✅ Bootstrap complete."
echo "   Next: review .env.local, then run 'pnpm dev'"
